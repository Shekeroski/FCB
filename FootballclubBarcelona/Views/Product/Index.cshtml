@model IEnumerable<FootballclubBarcelona.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-5 mb-5">
    
    <div class="text-center mb-5">

        <h1 class="display-4 fw-bold" style="color:lightyellow">
            🔵🔴 Barça Shop
        </h1>
        <p class="lead text-muted" style="color:lightyellow">
            Official FC Barcelona products
        </p>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success btn-lg mt-2">
                + Add New Product
            </a>
        }

    </div>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">

                <div class="card shadow-lg border-0 h-100">


                    <div class="text-center p-4">

                        <img src="@item.Image"
                             alt="@item.Name"
                             class="img-fluid rounded"
                             style="height: 280px; width: 100%; object-fit: contain;" />

                    </div>

                    <div class="card-body text-center">

                        <h2 class="fw-bold">
                            @item.Name
                        </h2>

                        <p class="text-muted mb-2">
                            @item.CategoryName
                        </p>

                        <h3 class="text-success fw-bold mb-4">
                            @item.Price
                        </h3>

                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning">
                                    ✏️ Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger">
                                    🗑️ Delete
                                </a>
                            }

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info">
                                Details
                            </a>

                            <a asp-action="Productdetailsorder"
                               asp-route-id="@item.Id"
                               class="btn btn-success">
                                🛒 Order
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>