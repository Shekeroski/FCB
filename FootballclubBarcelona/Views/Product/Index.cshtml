@model IEnumerable<FootballclubBarcelona.Models.Product>

@{
    ViewData["Title"] = "Index";
}
<h1 style="color: deepskyblue">Products</h1>
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}
<p></p>
<br/>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <strong><p style="color: blue">@Html.DisplayFor(modelItem => item.Name)</p></strong>
            </td>
            <td>
                <img width="200px" src="@item.Image"/>
            </td>
            <td>
                <strong><p style="color: blue">@Html.DisplayFor(modelItem => item.Price)</p></strong>
            </td>
            <td>
                <strong><p style="color: blue">@Html.DisplayFor(modelItem => item.CategoryName)</p></strong>
            </td>
            <td>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                }
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Productdetailsorder" asp-route-id="@item.Id" class="btn btn-sm btn-success">Order</a>
            </td>
        </tr>
}
    </tbody>
</table>
