@model FootballclubBarcelona.Models.ProductPurchasing

@{
    ViewData["Title"] = "Order";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h1 class="mb-0">
                         Order Product
                    </h1>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <img src="@ViewBag.ProductImage"
                             alt="@ViewBag.ProductName"
                             class="img-fluid rounded"
                             style="width: 250px; height: 250px; object-fit: contain;">
                    </div>
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">
                            @ViewBag.ProductName
                        </h2>
                        <p class="text-muted mb-2">
                            @ViewBag.ProductCategory
                        </p>
                        <h3 class="text-success fw-bold">
                            @ViewBag.ProductPrice
                        </h3>
                    </div>
                    <hr />
                    <div class="alert alert-info text-center mb-4">
                         <strong>Card Payment</strong>
                        <br />
                        Enter your card details below to complete your order.
                    </div>
                    <form asp-action="Order" method="post">
                        <input type="hidden" asp-for="PlayerName" />
                        <input type="hidden" asp-for="ProductId" />
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Card Number
                            </label>
                            <input type="text"
                                   class="form-control form-control-lg"
                                   placeholder="1234 5678 9012 3456"
                                   required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                CCV
                            </label>
                            <input type="text"
                                   class="form-control form-control-lg"
                                   placeholder="123"
                                   maxlength="3"
                                   minlength="3"
                                   pattern="[0-9]{3}"
                                   required />

                        </div>
                        <button type="submit"
                                class="btn btn-success btn-lg w-100">
                             Place Order
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>