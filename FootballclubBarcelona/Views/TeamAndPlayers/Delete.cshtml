@model FootballclubBarcelona.Models.TeamAndPlayers

@{
    ViewData["Title"] = "Delete";
}

<h1 style="color: lightyellow">Delete</h1>

<h3 style="color: lightyellow">Are you sure you want to delete this?</h3>
<div>
    <h4 style="color: lightyellow">TeamAndPlayers</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2" style="color: lightyellow">
            @Html.DisplayNameFor(model => model.name)
        </dt>
        <dd class = "col-sm-10" style="color: lightyellow">
            @Html.DisplayFor(model => model.name)
        </dd>
        <dt class = "col-sm-2" style="color: lightyellow">
            @Html.DisplayNameFor(model => model.years)
        </dt>
        <dd class = "col-sm-10" style="color: lightyellow">
            @Html.DisplayFor(model => model.years)
        </dd>
        <dt class = "col-sm-2" style="color: lightyellow">
            @Html.DisplayNameFor(model => model.position)
        </dt>
        <dd class = "col-sm-10" style="color: lightyellow">
            @Html.DisplayFor(model => model.position)
        </dd>
        <dt class = "col-sm-2" style="color: lightyellow">
            @Html.DisplayNameFor(model => model.image)
        </dt>
