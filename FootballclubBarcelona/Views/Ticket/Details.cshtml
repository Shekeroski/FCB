@model FootballclubBarcelona.Models.Ticket

@{
    ViewData["Title"] = "Details";
}

<h1 style="color: lightyellow">Details</h1>

<div>
    <h4 style="color: lightyellow">Ticket</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            <p style="color: lightyellow">@Html.DisplayNameFor(model => model.Side)</p>
        </dt>
        <dd class = "col-sm-10">
            <p style="color: lightyellow">@Html.DisplayFor(model => model.Side)</p>
        </dd>
        <dt class = "col-sm-2">
            <p style="color: lightyellow">@Html.DisplayNameFor(model => model.Block)</p>
        </dt>
        <dd class = "col-sm-10">
            <p style="color: lightyellow">@Html.DisplayFor(model => model.Block)</p>
        </dd>
        <dt class = "col-sm-2">
            <p style="color: lightyellow">@Html.DisplayNameFor(model => model.Seat)</p>
        </dt>
        <dd class = "col-sm-10">
            <p style="color: lightyellow">@Html.DisplayFor(model => model.Seat)</p>
        </dd>
        <dt class = "col-sm-2">
            <p style="color: lightyellow">@Html.DisplayNameFor(model => model.price)</p>
        </dt>
        <dd class = "col-sm-10">
            <p style="color: lightyellow">@Html.DisplayFor(model => model.price)</p>
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Admin"))
    {
        <form asp-action="Edit" asp-route-id="@Model?.Id">
            <button type="submit">Edit</button>
        </form>
    }
    <form asp-action="Index">
        <button type="submit">Back to list</button>
    </form>
</div>
