@model IEnumerable<FootballclubBarcelona.Models.Ticket>

@{
    ViewData["Title"] = "Index";
}
<h1 style="color: deepskyblue">Tickets</h1>
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Side)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Block)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Seat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.price)
            </th>
            <th>
                Opponent
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <p style="color: red"><strong>@Html.DisplayFor(modelItem => item.Side)</strong></p>
            </td>
            <td>
                <p style="color: blue"><strong>@Html.DisplayFor(modelItem => item.Block)</strong></p>
            </td>
            <td>
                <p style="color: red"><strong>@Html.DisplayFor(modelItem => item.Seat)</strong></p>
            </td>
            <td>
                <p style="color: blue"><strong>@Html.DisplayFor(modelItem => item.price)</strong></p>
            </td>
            <td><p style="color: red"><strong>@item.Match?.Opponent</strong></p></td>
            <td> <form asp-action="Purchasee" asp-route-id="@item.Id">
                <button type="submit">Purchase ticket</button>
            </form> </td>
            <td>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                }
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>
