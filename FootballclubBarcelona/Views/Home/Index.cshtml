@{
    ViewData["Title"] = "FC Barcelona - Home";
}

<div class="container mt-4">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold" style="color:lightyellow">FC BARCELONA</h1>
        <p class="lead" style="color: lightyellow">Més que un club</p>
    </div>

    <h2 class="mb-4" style="color:lightyellow;">Latest Barça News</h2>

    <div class="row">

        <!-- News 1 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <img src="https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" style="height:220px; object-fit:cover;">

                <div class="card-body">
                    <h5 class="card-title">Pedro Rodríguez announces retirement</h5>
                    <p class="text-muted">October 7, 2026</p>
                    <p class="card-text">
                        Former Barça striker Pedro Rodríguez has announced his retirement
                        from top-level football.
                    </p>
                </div>
            </div>
        </div>

        <!-- News 2 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <img src="https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" style="height:220px; object-fit:cover;">

                <div class="card-body">
                    <h5 class="card-title">More international players return</h5>
                    <p class="text-muted">October 7, 2026</p>
                    <p class="card-text">
                        Koundé, Bernal, Espart and Cancelo have returned while
                        Joan García trained with the squad.
                    </p>
                </div>
            </div>
        </div>

        <!-- News 3 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <img src="https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" style="height:220px; object-fit:cover;">

                <div class="card-body">
                    <h5 class="card-title">Barça prepares for Getafe</h5>
                    <p class="text-muted">October 7, 2026</p>
                    <p class="card-text">
                        Barcelona prepares for its first match following the
                        international break against Getafe.
                    </p>
                </div>
            </div>
        </div>

        <!-- News 4 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <img src="https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" style="height:220px; object-fit:cover;">

                <div class="card-body">
                    <h5 class="card-title">Emotional farewell for Leo Messi</h5>
                    <p class="text-muted">October 7, 2026</p>
                    <p class="card-text">
                        Barça legend Leo Messi has made his final appearance
                        with the Argentina national team.
                    </p>
                </div>
            </div>
        </div>

        <!-- News 5 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <img src="https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" style="height:220px; object-fit:cover;">

                <div class="card-body">
                    <h5 class="card-title">Cubarsí, Bernal and Espart nominated for Golden Boy</h5>
                    <p class="text-muted">October 5, 2026</p>
                    <p class="card-text">
                        Three young Barça talents are among the finalists
                        for the Golden Boy award.
                    </p>
                </div>
            </div>
        </div>

        <!-- News 6 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <img src="https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" style="height:220px; object-fit:cover;">

                <div class="card-body">
                    <h5 class="card-title">Barça return to training</h5>
                    <p class="text-muted">October 5, 2026</p>
                    <p class="card-text">
                        The team returned to training with their sights set
                        on the upcoming game against Getafe.
                    </p>
                </div>
            </div>
        </div>

        <!-- News 7 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <img src="https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" style="height:220px; object-fit:cover;">

                <div class="card-body">
                    <h5 class="card-title">Raphinha wins September Liga MVP</h5>
                    <p class="text-muted">October 2, 2026</p>
                    <p class="card-text">
