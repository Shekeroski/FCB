@model FootballclubBarcelona.Models.Shop

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Shop</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ShopName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ShopName)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

<div>
    <table>
    <thead>
    <tr>
    <th>Name</th>
    <th>Image</th>
    <th>Price</th>
    <th>Category</th>
    </tr>
    </thead>
        <tbody>
        @foreach (var product in @Model.Products)
        {
            <tr>
                <td>@product.Name</td>
                <td><img width="150px" src="@product.Image"></td>
                <td>@product.Price</td>
                <td>@product.CategoryName</td>
            </tr>
        }
        </tbody>
    </table>
</div>
