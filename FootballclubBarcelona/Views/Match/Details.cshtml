@model FootballclubBarcelona.Models.Match

@{
    ViewData["Title"] = "Match Details";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white text-center py-3">

                    <h1 class="mb-0">
                         Match Details
                    </h1>

                </div>
                <div class="card-body p-4 text-center">
                    <h2 class="fw-bold mb-4">
                        🔵🔴 Barcelona VS @Model.Opponent
                    </h2>

                    <hr />
                    <div class="row mt-4">
                        <div class="col-md-6 mb-4">
                            <h5 class="fw-bold">
                                 Competition
                            </h5>
                            <p class="text-muted fs-5">
                                @Model.Competition
                            </p>

                        </div>
                        <div class="col-md-6 mb-4">
                            <h5 class="fw-bold">
                                🏟 Stadium
                            </h5>
                            <p class="text-muted fs-5">
                                @Model.Stadium
                            </p>
                        </div>
                        <div class="col-md-12">
                            <h5 class="fw-bold">
                                 Date
                            </h5>
                            <p class="text-muted fs-5">
                                @Model.Date
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card shadow-lg border-0 mb-5">
        <div class="card-header bg-dark text-white text-center py-3">
            <h2 class="mb-0">
                 Available Tickets
            </h2>
        </div>

        <div class="card-body p-4">

            @if (Model.Tickets != null && Model.Tickets.Any())
            {
                <div class="row">
                    @foreach (var ticket in Model.Tickets)
                    {
                        <div class="col-md-6 mb-4">
                            <div class="card h-100 border shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h4 class="fw-bold mb-0">
                                             Ticket
                                        </h4>
                                        <span class="badge bg-success fs-6">
                                            @ticket.price
                                        </span>
                                    </div>
                                    <hr />
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <strong>Side</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            @ticket.Side
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <strong>Block</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            @ticket.Block
                                        </div>
                                    </div>
                                    <div class="row mb-4">
                                        <div class="col-6">
                                            <strong>Seat</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            @ticket.Seat
                                        </div>
                                    </div>
                                    <form asp-controller="Ticket"
                                          asp-action="Purchasee"
                                          asp-route-id="@ticket.Id">
                                        <button type="submit"
                                                class="btn btn-success w-100">
                                             Purchase Ticket
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info text-center mb-0">
                    No tickets available for this match.
                </div>
            }

        </div>

    </div>
    <div class="text-center">

        <form asp-action="Index">

            <button type="submit"
                    class="btn btn-secondary btn-lg">
                ← Back to Matches
            </button>

        </form>

    </div>

</div>