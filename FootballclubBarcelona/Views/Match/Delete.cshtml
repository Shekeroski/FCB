@model FootballclubBarcelona.Models.Match

@{
    ViewData["Title"] = "Delete";
}

<h1 style="color: lightyellow">Delete</h1>
<div>
    <h4 style="color: lightyellow">Match</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2" style="color: lightyellow">
            @Html.DisplayNameFor(model => model.Competition)
        </dt>
        <dd class = "col-sm-10" style="color: lightyellow">
            @Html.DisplayFor(model => model.Competition)
        </dd>
        <dt class = "col-sm-2" style="color: lightyellow">
            @Html.DisplayNameFor(model => model.Opponent)
        </dt>
        <dd class = "col-sm-10" style="color: lightyellow">
            @Html.DisplayFor(model => model.Opponent)
        </dd>
        <dt class = "col-sm-2" style="color: lightyellow">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10" style="color: lightyellow">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class = "col-sm-2" style="color: lightyellow">
            @Html.DisplayNameFor(model => model.Stadium)
        </dt>
        <dd class = "col-sm-10" style="color: lightyellow">
            @Html.DisplayFor(model => model.Stadium)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
