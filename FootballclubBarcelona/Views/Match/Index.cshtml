@model IEnumerable<FootballclubBarcelona.Models.Match>

@{
    ViewData["Title"] = "Matches";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold" style="color:lightyellow">
            🔵🔴 Barcelona Matches
        </h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success btn-lg mt-2">
                + Create New Match
            </a>
        }
    </div>
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-header bg-dark text-white text-center py-3">
            <h3 class="mb-0">
                 Search Matches
            </h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="Index" method="get">
                <div class="row align-items-end">
                    <div class="col-md-5 mb-3">
                        <label class="form-label fw-bold">
                            Competition
                        </label>
                        <input type="text"
                               name="competition"
                               value="@ViewBag.CompetitionFilter"
                               class="form-control"
                               placeholder="e.g. La Liga" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label fw-bold">
                            Opponent
                        </label>
                        <input type="text"
                               name="opponent"
                               value="@ViewBag.OpponentFilter"
                               class="form-control"
                               placeholder="e.g. Real Madrid" />
                    </div>
                    <div class="col-md-2 mb-3">
                        <button type="submit"
                                class="btn btn-primary w-100">
                             Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-dark text-white text-center">
                        <h4 class="mb-0">
                             FC Barcelona
                        </h4>
                    </div>
                    <div class="card-body text-center">
                        <h2 class="fw-bold mb-3">
                            Barcelona VS @item.Opponent
                        </h2>
                        <hr />
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Competition</strong>
                                <p class="text-muted mt-1 mb-0">
                                    @item.Competition
                                </p>

                            </div>

                            <div class="col-6">
                                <strong>Stadium</strong>
                                <p class="text-muted mt-1 mb-0">
                                    @item.Stadium
                                </p>
                            </div>
                        </div>
                        <div class="mb-4">
                            <strong> Date</strong>
                            <p class="text-muted mt-1 mb-0">
                                @item.Date
                            </p>
                        </div>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning">
                                    Edit
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger">
                                    Delete
                                </a>
                            }
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info">
                                Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-4">
            No matches were found with the selected filters.
        </div>
    }

</div>